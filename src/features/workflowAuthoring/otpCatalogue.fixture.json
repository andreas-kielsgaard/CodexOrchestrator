[
  {
    "agentMcpServers": [],
    "contractVersion": 1,
    "id": "workflow",
    "requestedHandles": [
      "definitions",
      "node_sessions",
      "emit_output"
    ],
    "tools": [
      {
        "configuration": [],
        "description": "Trigger connections configured for this call from this node. Follow your instructions for when to call it.",
        "entrypoint": {
          "inputSchema": {
            "additionalProperties": false,
            "properties": {
              "data": {
                "type": "object"
              },
              "outputFiles": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "kind": "mcp"
        },
        "id": "trigger_workflow_continuation",
        "name": "Workflow continuation",
        "outputs": [
          {
            "id": "continuation",
            "kind": "data",
            "name": "Continuation",
            "schema": {
              "additionalProperties": false,
              "properties": {
                "data": {
                  "type": "object"
                },
                "outputFiles": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "sourceNode": {
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          }
        ]
      },
      {
        "configuration": [],
        "description": "Publish file paths and prompt text to this node's configured handoff connections.",
        "entrypoint": {
          "inputSchema": {
            "additionalProperties": false,
            "properties": {
              "filePaths": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "promptText": {
                "type": "string"
              }
            },
            "required": [
              "filePaths",
              "promptText"
            ],
            "type": "object"
          },
          "kind": "mcp"
        },
        "id": "handoff_to_agent",
        "name": "Handoff to agent",
        "outputs": [
          {
            "id": "handoff",
            "kind": "data",
            "name": "Handoff",
            "schema": {
              "additionalProperties": false,
              "properties": {
                "filePaths": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "promptText": {
                  "type": "string"
                },
                "sourceNode": {
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          }
        ]
      },
      {
        "configuration": [],
        "description": "Emit when an invocation on the bound source node completes.",
        "entrypoint": {
          "event": "invocation_terminal",
          "kind": "session_event"
        },
        "id": "on_invocation_completed",
        "name": "Invocation completed",
        "outputs": [
          {
            "id": "completed",
            "kind": "data",
            "name": "Completed",
            "schema": {
              "additionalProperties": false,
              "properties": {
                "output": {
                  "type": "string"
                },
                "sourceNode": {
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          }
        ]
      },
      {
        "configuration": [
          {
            "choices": [
              "select",
              "new"
            ],
            "defaultValue": "select",
            "key": "mode",
            "label": "Session mode",
            "when": null
          },
          {
            "choices": [
              "first",
              "all"
            ],
            "defaultValue": "first",
            "key": "cardinality",
            "label": "Sessions to select",
            "when": [
              "mode",
              "select"
            ]
          },
          {
            "choices": [
              "newest",
              "last_addressed"
            ],
            "defaultValue": "newest",
            "key": "ordering",
            "label": "Order sessions",
            "when": [
              "mode",
              "select"
            ]
          },
          {
            "choices": [
              "any",
              "running_only",
              "not_running"
            ],
            "defaultValue": "any",
            "key": "running",
            "label": "Invocation state",
            "when": [
              "mode",
              "select"
            ]
          },
          {
            "choices": [
              "create",
              "fail",
              "noop"
            ],
            "defaultValue": "create",
            "key": "missing",
            "label": "If no session matches",
            "when": [
              "mode",
              "select"
            ]
          },
          {
            "choices": [],
            "defaultValue": "",
            "key": "createdByEvent",
            "label": "Created by event",
            "when": [
              "mode",
              "select"
            ]
          },
          {
            "choices": [],
            "defaultValue": "",
            "key": "createdBySession",
            "label": "Created by session",
            "when": [
              "mode",
              "select"
            ]
          }
        ],
        "description": "Choose destination-node sessions and request delivery of the configured prompt.",
        "entrypoint": {
          "kind": "action",
          "usesPrompt": true
        },
        "id": "prompt_agent",
        "name": "Prompt agent",
        "outputs": [
          {
            "id": "session",
            "kind": "session_request",
            "name": "Agent session",
            "schema": {
              "type": "object"
            }
          }
        ]
      },
      {
        "configuration": [
          {
            "choices": [
              "newest",
              "last_addressed"
            ],
            "defaultValue": "newest",
            "key": "ordering",
            "label": "Order running sessions",
            "when": null
          }
        ],
        "description": "Request cancellation of one running session of the destination node. The session remains available for later prompts.",
        "entrypoint": {
          "kind": "action",
          "usesPrompt": false
        },
        "id": "stop_session",
        "name": "Stop session",
        "outputs": [
          {
            "id": "stop",
            "kind": "session_stop_request",
            "name": "Session cancellation",
            "schema": {
              "type": "object"
            }
          }
        ]
      }
    ]
  }
]