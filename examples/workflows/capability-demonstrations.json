          "positionY": 100,
          "isStartingPoint": false,
          "harness": {
            "kind": "standalone",
            "config": {
              "harnessName": "Fresh demonstration reviewer",
              "roleIdentity": "Review one handed-off artifact in an isolated Session.",
              "instructions": "Open the relative file path at the start of the prompt. Report two strengths and one concrete improvement. Do not edit files.",
              "runtime": {
                "provider": "codex",
                "model": "gpt-5.6-terra",
                "reasoningEffort": "low"
              }
            }
          }
        },
        {
          "id": "example-matrix-continuing-reviewer",
          "name": "Continuing reviewer",
          "harnessName": "Continuing demonstration reviewer",
          "roleName": null,
          "positionX": 540,
          "positionY": 340,
          "isStartingPoint": false,
          "harness": {
            "kind": "standalone",
            "config": {
              "harnessName": "Continuing demonstration reviewer",
              "roleIdentity": "Review successive revisions in one continuing Session.",
              "instructions": "Open the relative file path at the start of the prompt. Compare it with any earlier revision in this Session, then give a concise verdict. Do not edit files.",
              "runtime": {
                "provider": "codex",
                "model": "gpt-5.6-terra",
                "reasoningEffort": "low"
              }
            }
          }
        }
      ],
      "connections": [
        {
          "id": "example-matrix-to-fresh",
          "name": "Fresh review for every revision",
          "senderNodeId": "example-matrix-author",
          "receiverNodeId": "example-matrix-fresh-reviewer",
          "receiverSessionPolicy": "fresh",
          "mechanism": {
            "kind": "turn_finished_expected_file",
            "fileSelector": {
              "kind": "folder_filename_pattern",
              "folder": "handoffs",
              "filenamePattern": "demo-plan.md"
            },
            "descriptionText": "The author produced this demonstration plan.",
            "promptText": "Review the current revision now.",
            "matchSelection": "newest",
            "initialCheck": "once_immediately"
          }
        },
        {
          "id": "example-matrix-to-continuing",
          "name": "Continue review across revisions",
          "senderNodeId": "example-matrix-author",
          "receiverNodeId": "example-matrix-continuing-reviewer",
          "receiverSessionPolicy": "continue_latest",
          "mechanism": {
            "kind": "turn_finished_expected_file",
            "fileSelector": {
              "kind": "folder_filename_pattern",
              "folder": "handoffs",
              "filenamePattern": "demo-plan.md"
            },
            "descriptionText": "The author produced another revision of this demonstration plan.",
            "promptText": "Review it in the context of the revisions you have already seen.",
            "matchSelection": "newest",
            "initialCheck": "once_immediately"
          }
        }
      ]
    },
    {
      "name": "Example · Agent-selected Artifact",
      "nodes": [
        {
          "id": "example-regex-writer",
          "name": "Artifact selector",
          "harnessName": "Agent-selected artifact writer",
          "roleName": null,
          "positionX": 140,
          "positionY": 220,
          "isStartingPoint": true,
          "harness": {
            "kind": "standalone",
            "config": {
              "harnessName": "Agent-selected artifact writer",
              "roleIdentity": "Choose and create a fitting Markdown handoff artifact.",
              "instructions": "Create one Markdown file inside handoffs. Use a short descriptive filename. End your final response with exactly HANDOFF: followed by that filename only, without the folder prefix.",
              "runtime": {
                "provider": "codex",
                "model": "gpt-5.6-terra",
                "reasoningEffort": "low"
              }
            }
          }
        },
        {
          "id": "example-regex-reader",
          "name": "Selected artifact reader",
          "harnessName": "Selected artifact reader",
          "roleName": null,
          "positionX": 560,
          "positionY": 220,
          "isStartingPoint": false,
          "harness": {
            "kind": "standalone",
            "config": {
              "harnessName": "Selected artifact reader",
              "roleIdentity": "Read the artifact selected by the previous agent.",
              "instructions": "Open the relative file path at the start of the prompt and summarize its purpose in three bullets. Do not edit files.",
              "runtime": {
                "provider": "codex",
                "model": "gpt-5.6-terra",
                "reasoningEffort": "low"
              }
            }
          }
        }
      ],
      "connections": [
        {
          "id": "example-regex-handoff",
          "name": "Use the filename selected in agent output",
          "senderNodeId": "example-regex-writer",
          "receiverNodeId": "example-regex-reader",
          "receiverSessionPolicy": "fresh",
          "mechanism": {
            "kind": "turn_finished_expected_file",
            "fileSelector": {
              "kind": "folder_output_regex",
              "folder": "handoffs",
              "outputRegex": "HANDOFF:\\s+([A-Za-z0-9._-]+\\.md)"
            },
            "descriptionText": "The previous agent selected this artifact in its final output.",
            "promptText": "Read and summarize the selected artifact.",
            "matchSelection": "newest",
            "initialCheck": "once_immediately"
          }
        }
      ]
    },
