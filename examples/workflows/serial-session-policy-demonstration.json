{
  "contractVersion": "workflow-cli-catalog/v1",
  "workflows": [
    {
      "name": "Example · Serial Session Policies",
      "nodes": [
        {
          "id": "example-serial-author",
          "name": "Revision author",
          "harnessName": "Serial demonstration author",
          "roleName": null,
          "positionX": 100,
          "positionY": 220,
          "isStartingPoint": true,
          "harness": {
            "kind": "standalone",
            "config": {
              "harnessName": "Serial demonstration author",
              "roleIdentity": "Create successive revisions of one demonstration artifact.",
              "instructions": "Follow the user's request and create or overwrite handoffs/serial-plan.md. Do not finish until that exact file exists.",
              "runtime": {
                "provider": "codex",
                "model": "gpt-5.6-terra",
                "reasoningEffort": "low"
              }
            }
          }
        },
        {
          "id": "example-serial-fresh-reviewer",
          "name": "Per-revision reviewer",
          "harnessName": "Fresh serial reviewer",
          "roleName": null,
          "positionX": 440,
          "positionY": 220,
          "isStartingPoint": false,
          "harness": {
            "kind": "standalone",
            "config": {
              "harnessName": "Fresh serial reviewer",
              "roleIdentity": "Review exactly one revision in a fresh Session.",
              "instructions": "Open the relative file path at the start of the prompt. State one strength and one risk. Do not edit files.",
              "runtime": {
                "provider": "codex",
                "model": "gpt-5.6-terra",
                "reasoningEffort": "low"
              }
            }
          }
        },
        {
          "id": "example-serial-continuing-reviewer",
          "name": "Longitudinal reviewer",
          "harnessName": "Continuing serial reviewer",
          "roleName": null,
          "positionX": 780,
          "positionY": 220,
          "isStartingPoint": false,
          "harness": {
            "kind": "standalone",
            "config": {
              "harnessName": "Continuing serial reviewer",
              "roleIdentity": "Compare successive revisions in one continuing Session.",
              "instructions": "Open the relative file path at the start of the prompt. Compare the current revision with any earlier one you reviewed in this Session. Do not edit files.",
              "runtime": {
                "provider": "codex",
                "model": "gpt-5.6-terra",
                "reasoningEffort": "low"
              }
            }
          }
        }
      ],
      "connections": [
        {
          "id": "example-serial-to-fresh",
          "name": "Start a fresh per-revision review",
          "senderNodeId": "example-serial-author",
          "receiverNodeId": "example-serial-fresh-reviewer",
          "receiverSessionPolicy": "fresh",
          "mechanism": {
            "kind": "turn_finished_expected_file",
            "fileSelector": {
              "kind": "folder_filename_pattern",
              "folder": "handoffs",
              "filenamePattern": "serial-plan.md"
            },
            "descriptionText": "The author produced one revision for isolated review.",
            "promptText": "Review this revision, then finish so the longitudinal review can begin.",
            "matchSelection": "newest",
            "initialCheck": "once_immediately"
          }
        },
        {
          "id": "example-serial-to-continuing",
          "name": "Continue the longitudinal review",
          "senderNodeId": "example-serial-fresh-reviewer",
          "receiverNodeId": "example-serial-continuing-reviewer",
          "receiverSessionPolicy": "continue_latest",
          "mechanism": {
            "kind": "turn_finished_expected_file",
            "fileSelector": {
              "kind": "folder_filename_pattern",
              "folder": "handoffs",
              "filenamePattern": "serial-plan.md"
            },
            "descriptionText": "A fresh reviewer completed its review of the current revision.",
            "promptText": "Review this revision using the history retained in your continuing Session.",
            "matchSelection": "newest",
            "initialCheck": "once_immediately"
          }
        }
      ]
    }
  ]
}
