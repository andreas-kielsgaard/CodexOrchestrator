{
  "name": "codex-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:app": "npm install",
    "dev": "vite",
    "dev:status": "node scripts/runtime-status-server.mjs",
    "dev:tauri": "tauri dev",
    "runtime:worktree": "node scripts/worktree-runtime.mjs",
    "mark:stale": "node scripts/mark-stale.mjs",
    "clear:stale": "node scripts/clear-stale.mjs",
    "build": "tsc --noEmit && vite build",
    "build:tauri": "tauri build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rust:fast": "cargo test --manifest-path src-tauri/Cargo.toml --profile test-fast --lib",
    "test:rust:full": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:worktree-runtime": "node --test scripts/worktree-runtime.node-test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@vitejs/plugin-react": "^4.6.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
