{
  "name": "codex-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:app": "npm ci --include=dev",
    "dev": "vite",
    "dev:status": "node scripts/runtime-status-server.mjs",
    "dev:tauri": "tauri dev",
    "mark:stale": "node scripts/mark-stale.mjs",
    "clear:stale": "node scripts/clear-stale.mjs",
    "build": "node scripts/build-tools.mjs app",
    "build:tauri": "node scripts/build-tools.mjs app --bundle",
    "check:rust": "node scripts/build-tools.mjs check",
    "check:rust:release": "node scripts/build-tools.mjs check --release",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rust:fast": "node scripts/build-tools.mjs test --profile test-fast --lib",
    "test:rust:full": "node scripts/build-tools.mjs test --lib",
    "test:rust:worktree-review": "node scripts/build-tools.mjs test --profile test-fast --lib worktree_ -- --test-threads=1",
    "test:worktree-review": "vitest run src/app/ApplicationRoot.test.tsx src/app/App.agentSessions.test.tsx src/bootstrap/productApplicationComposition.test.ts src/features/repositoryCatalog/RepositoryWorktreeTargetSelector.test.tsx src/features/worktreeReview src/infrastructure/repositoryCatalog/tauriRepositoryCatalog.test.ts src/infrastructure/tauriWorktreeReview.test.ts",
    "validate:worktree-review": "npm run build:frontend && npm run test:worktree-review && npm run test:rust:worktree-review && npm run check:rust",
    "validate:release-build": "node scripts/build-tools.mjs app",
    "test:codex-app-server": "node --test scripts/codex-app-server-contract.node-test.mjs",
    "test:watch": "vitest",
    "test:app-inspector": "node --test review-tools/app-inspector/test/interaction-adapter-framing.test.mjs review-tools/app-inspector/test/launch-paths.test.mjs review-tools/app-inspector/test/rendered-state.test.mjs review-tools/app-inspector/test/snapshot-compare.test.mjs review-tools/app-inspector/test/wait-for-change.test.mjs review-tools/app-inspector/test/webview-control.test.mjs review-tools/app-inspector/test/windows-adapter-framing.test.mjs review-tools/app-inspector/test/windows-webview-owner-boundary.test.mjs",
    "test:app-inspector:browser": "node --test review-tools/app-inspector/test/webview-control-live.test.mjs",
    "build:frontend": "tsc --noEmit && vite build",
    "test:build-tools": "node --test scripts/build/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
