{
  "name": "codex-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:app": "npm install",
    "dev": "vite",
    "dev:status": "node scripts/runtime-status-server.mjs",
    "dev:tauri": "tauri dev",
    "mark:stale": "node scripts/mark-stale.mjs",
    "clear:stale": "node scripts/clear-stale.mjs",
    "build": "tsc --noEmit && vite build",
    "build:tauri": "tauri build",
    "build:native-review-frontend": "vite build --config vite.native-review.config.ts",
    "build:native-review-tauri": "tauri build --config src-tauri/tauri.native-review.conf.json --features native-review --no-bundle",
    "review:renderer": "playwright test --config playwright.review.config.ts",
    "review:native-attach": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent-review/run-windows-attachment.ps1",
    "review:native": "node scripts/agent-review/run-native-tauri-wdio.mjs",
    "review:production-exclusion": "npm run build && node scripts/agent-review/verify-production-exclusion.mjs",
    "review:retain-evidence": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent-review/retain-agent-review-evidence.ps1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@vitejs/plugin-react": "^4.6.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@wdio/cli": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "get-port": "7.1.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  }
}
