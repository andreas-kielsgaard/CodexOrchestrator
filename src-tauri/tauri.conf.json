{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Orchestrator",
  "version": "0.1.0",
  "identifier": "dev.codex-orchestrator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Orchestrator",
        "width": 1280,
        "height": 820,
        "maximized": true,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
