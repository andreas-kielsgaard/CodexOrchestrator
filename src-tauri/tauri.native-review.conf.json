{
  "identifier": "dev.codex-orchestrator.native-review",
  "build": {
    "beforeBuildCommand": "npm run build:native-review-frontend",
    "frontendDist": "../dist-native-review"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main-window-events",
        {
          "identifier": "native-review-wdio",
          "description": "Grants the isolated native review build access to the WebdriverIO test bridge.",
          "windows": ["main"],
          "permissions": ["core:default", "wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
